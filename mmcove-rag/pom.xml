<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.mmcove</groupId>
        <artifactId>mmcove-ai-agent</artifactId>
        <version>1.0.0-SNAPSHOT</version>
    </parent>

    <artifactId>mmcove-rag</artifactId>
    <name>Mmcove RAG</name>
    <description>RAG 向量库领域：知识入库、向量检索、场景选库（Spring AI + Milvus）</description>

    <dependencies>
        <dependency>
            <groupId>com.mmcove</groupId>
            <artifactId>mmcove-common</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mmcove</groupId>
            <artifactId>mmcove-infra</artifactId>
        </dependency>
        <!-- mmcove-llm:KnowledgeBaseRouter 选库复用 LlmGateway.detectIntent -->
        <dependency>
            <groupId>com.mmcove</groupId>
            <artifactId>mmcove-llm</artifactId>
        </dependency>

        <!-- Spring AI Milvus 向量库（版本由根 pom 的 spring-ai-bom 统一管理） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-vector-store-milvus</artifactId>
        </dependency>
        <!-- Spring AI OpenAI（EmbeddingModelFactory 构建 OpenAI 兼容 Embedding；版本由 BOM 管理） -->
        <dependency>
            <groupId>org.springframework.ai</groupId>
            <artifactId>spring-ai-starter-model-openai</artifactId>
        </dependency>
    </dependencies>
</project>
