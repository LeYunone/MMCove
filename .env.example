# 复制为 .env 后按需修改（.env 已被 .gitignore 忽略）

# ---------- MySQL ----------
MYSQL_ROOT_PASSWORD=rootpass
MYSQL_DB=mmcove
MYSQL_USER=mmcove
MYSQL_PASSWORD=mmcove
MYSQL_PORT=3306

# ---------- Redis ----------
REDIS_PASSWORD=
REDIS_PORT=6379

# ---------- Milvus ----------
MILVUS_PORT=19530

# ---------- 后端运行期 ----------
MMCOVE_PROFILE=dev
MMCOVE_JWT_SECRET=please-change-me-to-a-long-random-secret-at-least-32-bytes

# AI 渠道（默认种子：OpenAI 兼容）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com

# 智谱 GLM（OpenAI 兼容，可作第二条渠道）
ZHIPU_API_KEY=
